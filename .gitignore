# Python
.venv/
__pycache__/
*.pyc

# Big files: keep out of git
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
papers/**/*.pdf

# Experiment outputs (keep summaries, skip heavy files)
results/**/*.npy
results/**/*.tif

# Mac / editors
.DS_Store
.vscode/
.env

# Demo photo thumbnails (made by python -m src.demo.export; AID licence unclear)
demo/thumbs/

# Website built by python -m src.demo.build_site (GitHub Pages)
site/

# Downloads from Kaggle runs (logs + embeddings; the CSVs are copied into results/<experiment>/)
results/kaggle_downloads/

# Old PDFs (kept locally, not in git)
archive/*.pdf

# Report outputs (rebuild with: python report/build.py)
report/report.html
report/*.pdf
